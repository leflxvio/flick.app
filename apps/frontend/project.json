{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "frontend",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "tags": [
    "type:app",
    "scope:frontend"
  ],
  "targets": {
    "docker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/frontend/Dockerfile -t flick-frontend .",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
