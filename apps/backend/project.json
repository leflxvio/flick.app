{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "apps/backend/src",
  "tags": [
    "type:app",
    "scope:backend"
  ],
  "targets": {
    "docker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/backend/Dockerfile -t flick-backend .",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
