{
  "name": "@flick/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.development --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env.production --env-file-if-exists=.env dist/server.js",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0"
  }
}
